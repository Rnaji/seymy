# Copy to .env and fill in values. Never commit .env.

# Required
DJANGO_SECRET_KEY=

# Optional — Stripe (blank = local demo checkout / webhook path)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Optional — landing download CTA (one validated channel; blank = "private pilot" note, no link)
SITE_DOWNLOAD_URL=
SITE_DOWNLOAD_LABEL=Get the Seymy app
